# Copy to .env and adjust as needed
APP_NAME=PrepPath API
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Postgres (Project Settings → Database → Connection string → URI)
# For local uvicorn, prefer Session mode pooler or Direct connection (port 5432).
# Example (Session pooler):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Example (Direct):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=

# BotFather token (never commit the real value)
TELEGRAM_BOT_TOKEN=
# Optional. Required only after you expose a public HTTPS webhook.
TELEGRAM_WEBHOOK_SECRET=
# true = send T−72 / T−24 / T−6 one per minute after /start, then stop.
TELEGRAM_REMINDER_TEST=true
SITE_URL=http://localhost:5173
