# Copy to .env and adjust as needed
APP_NAME=PrepPath API
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dont-dread-the-prep.vercel.app
# Vercel preview URLs for this project. Leave as-is, or set empty to disable.
# CORS_ORIGIN_REGEX=https://dont-dread-the-prep(?:-[a-z0-9-]+)?\.vercel\.app

# Railway: DEBUG=false
# Railway: CORS_ORIGINS=https://dont-dread-the-prep.vercel.app

# Supabase Postgres (Project Settings → Database → Connection string → URI)
# For Railway and local uvicorn, prefer Session mode pooler (port 5432) + sslmode=require.
# Example (Session pooler):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Example (Direct):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# BotFather token (never commit the real value)
TELEGRAM_BOT_TOKEN=
# Optional. If empty, a token-derived secret is used for the Railway webhook.
TELEGRAM_WEBHOOK_SECRET=
# true = demo ladder after link: now / +1 min / +2 min, then 3 hourly, then 3 daily.
# false (or omit) = live T−72 / T−24 / T−6 from the appointment time.
TELEGRAM_REMINDER_TEST=true
SITE_URL=http://localhost:5173
# Railway: leave empty to use https://$RAILWAY_PUBLIC_DOMAIN
# PUBLIC_API_URL=https://dont-dread-the-prep-production.up.railway.app
# Local getUpdates only. Deletes the bot webhook — leave unset when Railway owns the bot.
# TELEGRAM_POLL=true

# Web Push (PWA). Generate once; never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:preppath@localhost

# Food chat — any OpenAI-compatible Chat Completions API (currently pointed
# at Google AI Studio's Gemini endpoint for its generous free daily limits
# on Flash models, despite the GOOGLE_* variable names below).
# Get a key at https://aistudio.google.com/apikey. Never commit the real key.
# Leave GOOGLE_API_KEY empty to keep the chat tab disabled ("not configured").
# Model catalogue: https://ai.google.dev/gemini-api/docs/models — swap
# gemini-3.8-flash for gemini-3.1-flash-lite for an even higher free quota,
# or any current Flash/Flash-Lite id if this one has since been retired.
# To use OpenAI instead: https://api.openai.com/v1 + an OpenAI key + gpt-* model.
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
